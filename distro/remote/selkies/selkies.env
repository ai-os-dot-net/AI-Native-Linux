# AIOS Selkies remote desktop stream — configuration (Stream B1 scaffold)
#
# This file is inert on its own. The stream only starts when:
#   1. /etc/aios/policy/remote-desktop.enabled exists and contains
#      AIOS_REMOTE_DESKTOP_POLICY_GRANTED=true (see aios-selkies-ctl.sh), AND
#   2. the real Selkies/Smithay/KWin binaries are packaged for AIOS, which
#      DESIGN.md §7 lists as unproven/deferred.
#
# LAN or public exposure is OUT OF SCOPE for this file. Rev.2 INV-006
# requires LAN/public exposure to go through the L7 Web Renderer
# WEB_EXPOSURE_GRANTED FSM (002.AI-OS.NET--SPECREV.2/L7_Interaction_Renderers/
# 05_web_renderer.md §5), not through editing this env file. Do not change
# SELKIES_BIND_ADDRESS away from a loopback address outside that FSM.

# Loopback-only bind (INV-006 EXPOSURE_LOOPBACK posture).
SELKIES_BIND_ADDRESS=127.0.0.1
SELKIES_BIND_PORT=8080

# Wayland mode via the pixelflux/Smithay stack (DESIGN.md §2.2). KWin nests
# inside the Smithay virtual framebuffer and hosts the existing Plasma
# session; do not set this to false without re-reading DESIGN.md §2.1 (the
# X11/EGL/NVIDIA-only lineage is not compatible with AIOS's Wayland desktop).
PIXELFLUX_WAYLAND=true

# Transport: WebSocket + WebCodecs by default per upstream Selkies docs
# (DESIGN.md §2.2 source). WebRTC is opt-in upstream and is NOT enabled here
# because it pulls in a TURN dependency this loopback-only posture does not
# need (DESIGN.md §3 item 4).
SELKIES_TRANSPORT=websocket

# Basic auth is on; the password is read from a file, never placed inline in
# this env file, so it does not leak via `systemctl show` or /proc/<pid>/environ.
# Populating this file is out of scope for this stream (DESIGN.md §7) —
# belongs to the future Vault Broker / L4 secrets integration.
SELKIES_ENABLE_BASIC_AUTH=true
SELKIES_BASIC_AUTH_PASSWORD_FILE=/etc/aios/remote/selkies-password

# --- TURN (coturn) — commented out, not needed for the loopback-only
# --- default (DESIGN.md §3 item 4, §4). Only relevant once a future
# --- WEB_EXPOSURE_GRANTED LAN escalation also opts into WebRTC transport.
# SELKIES_TURN_HOST=
# SELKIES_TURN_PORT=3478
# SELKIES_TURN_PROTOCOL=udp
# TURN_MIN_PORT=65532
# TURN_MAX_PORT=65535
