[Unit]
Description=AI-OS.NET Autonomous Orchestrator
Documentation=https://ai-os.net/docs/autonomous
After=aios-fleet.service aios-cognitive-core.service
Wants=aios-fleet.service

[Service]
Type=simple
ExecStart=/usr/lib/aios/aios-system run-service aios-autonomous --config /etc/aios/config.toml
Restart=always
RestartSec=5
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/aios/autonomous /run/aios
NoNewPrivileges=yes
SELinuxContext=system_u:system_r:aios_autonomous_t:s0

[Install]
WantedBy=multi-user.target
