[Unit]
Description=AI-OS.NET Terminal Daemon
Documentation=https://ai-os.net/docs/terminal
After=aios-cognitive-core.service

[Service]
Type=simple
ExecStart=/usr/lib/aios/aios-system run-service aios-terminal --config /etc/aios/config.toml
Restart=always
RestartSec=5
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
# /var/lib/aios/state: run-service writes its readiness state file there
ReadWritePaths=/var/lib/aios/terminal /run/aios /var/lib/aios/state
NoNewPrivileges=yes
SELinuxContext=-system_u:system_r:aios_terminal_t:s0

[Install]
WantedBy=multi-user.target
