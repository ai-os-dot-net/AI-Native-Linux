[Unit]
Description=AI-OS.NET Terminal Daemon
Documentation=https://ai-os.net/docs/terminal
After=aios-cognitive-core.service

[Service]
Type=notify
ExecStart=/usr/lib/aios/aios-terminal --default-mode lx --config /etc/aios/config.toml
Restart=always
RestartSec=5
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/aios/terminal /run/aios
NoNewPrivileges=yes
SELinuxContext=system_u:system_r:aios_terminal_t:s0

[Install]
WantedBy=multi-user.target
