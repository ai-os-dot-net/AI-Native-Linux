[Unit]
Description=AI-OS.NET Marketplace Indexer
Documentation=https://ai-os.net/docs/marketplace
After=aios-capability-runtime.service aios-evidence-log.service
Wants=aios-capability-runtime.service

[Service]
Type=simple
ExecStart=/usr/lib/aios/aios-marketplace --auto-sync --config /etc/aios/config.toml
Restart=on-failure
RestartSec=10s
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/aios/marketplace /run/aios
NoNewPrivileges=yes
SELinuxContext=system_u:system_r:aios_marketplace_t:s0

[Install]
WantedBy=multi-user.target
