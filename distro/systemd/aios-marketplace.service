[Unit]
Description=AI-OS.NET Marketplace Indexer
Documentation=https://ai-os.net/docs/marketplace
After=aios-capability-runtime.service aios-evidence-log.service
Wants=aios-capability-runtime.service

[Service]
Type=simple
ExecStart=/usr/lib/aios/aios-system run-service aios-marketplace --config /etc/aios/config.toml
Restart=on-failure
RestartSec=10s
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
# /var/lib/aios/state: run-service writes its readiness state file there
ReadWritePaths=/var/lib/aios/marketplace /run/aios /var/lib/aios/state
NoNewPrivileges=yes
SELinuxContext=-system_u:system_r:aios_marketplace_t:s0

[Install]
WantedBy=multi-user.target
