[Unit]
Description=AI-OS.NET Fleet Coordinator
Documentation=https://ai-os.net/docs/fleet
After=aios-capability-runtime.service aios-network-daemon.service
Wants=aios-capability-runtime.service aios-network-daemon.service

[Service]
Type=simple
ExecStart=/usr/lib/aios/aios-system run-service aios-fleet --config /etc/aios/config.toml
Restart=always
RestartSec=5
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
# /var/lib/aios/state: run-service writes its readiness state file there
ReadWritePaths=/var/lib/aios/fleet /run/aios /var/lib/aios/state
NoNewPrivileges=yes
SELinuxContext=-system_u:system_r:aios_fleet_t:s0

[Install]
WantedBy=multi-user.target
