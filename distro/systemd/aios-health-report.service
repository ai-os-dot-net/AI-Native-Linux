[Unit]
Description=AI-OS.NET Boot-Time Service Health Report
Documentation=https://ai-os.net/docs/health
Wants=aios.target multi-user.target
# NB: never order After=multi-user.target while WantedBy=multi-user.target —
# that is an ordering cycle and systemd SKIPS the unit (the boot gate then
# never sees the AIOS-HEALTH marker).
After=aios.target

[Service]
# Type=simple, NOT oneshot: a oneshot here deadlocks startup — multi-user.target
# waits for this unit to finish while the script's `is-system-running --wait`
# waits for startup to finish. With simple, the start job completes at exec.
Type=simple
ExecStart=/usr/lib/aios/aios-health-report.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
