[Unit]
Description=AI-OS.NET Container Daemon
Documentation=https://ai-os.net/docs/container
After=aios-sandbox-composer.service aios-fs-daemon.service
Requires=aios-sandbox-composer.service

[Service]
Type=simple
ExecStart=/usr/lib/aios/aios-system run-service aios-container --config /etc/aios/config.toml
Restart=always
RestartSec=5
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
# /var/lib/aios/state: run-service writes its readiness state file there
ReadWritePaths=/var/lib/aios/containers /run/aios /var/lib/aios/state
NoNewPrivileges=yes
SELinuxContext=-system_u:system_r:aios_container_t:s0

[Install]
WantedBy=multi-user.target
