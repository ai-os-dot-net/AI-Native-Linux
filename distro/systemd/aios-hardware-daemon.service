[Unit]
Description=AI-OS.NET Hardware Daemon
Documentation=https://ai-os.net/docs/hardware-daemon
After=aios-capability-runtime.service aios-evidence-log.service
Requires=aios-capability-runtime.service

[Service]
Type=simple
ExecStart=/usr/lib/aios/aios-system run-service aios-hardware-daemon --config /etc/aios/config.toml
Restart=always
RestartSec=5
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
# /var/lib/aios/state: run-service writes its readiness state file there
ReadWritePaths=/var/lib/aios/hardware /run/aios /var/lib/aios/state
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO
SELinuxContext=-system_u:system_r:aios_hardware_daemon_t:s0

[Install]
WantedBy=multi-user.target
