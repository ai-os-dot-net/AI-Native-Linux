# =============================================================================
# AI-OS.NET LIVE-ISO Autoinstall Trigger — Revision 13 (R13.6)
# =============================================================================
# This unit belongs to the LIVE ISO environment ONLY. It is NOT part of the
# installed-daemon set frozen by R13.3 (distro/systemd/), so it deliberately
# lives under distro/installer/ and is installed into the live rootfs by
# build-aios-iso.sh (Step 4). Do NOT move it into distro/systemd/ — the R13.3
# daemon gate (distro/build/tests/test-rev13-daemon.sh) asserts that directory
# contains no undocumented unit.
#
# Purpose: on a live boot whose kernel command line carries `aios.autoinstall`
# (injected by the QEMU install gate, distro/build/qemu-install-test.sh), run
# the non-interactive installer BEFORE the login prompt appears, then power off.
# A normal live boot (no `aios.autoinstall`) never satisfies the condition below,
# so it is completely unaffected and still reaches `aios login:`.
[Unit]
Description=AI-OS.NET Live Autoinstall (kernel-cmdline driven)
Documentation=https://ai-os.net/docs/install
# Fire ONLY when aios.autoinstall is present on the kernel command line. A normal
# live boot skips this unit entirely (still reaches the getty login prompt).
ConditionKernelCommandLine=aios.autoinstall
# Run after the live system is usable (core services up, virtio disk present) but
# BEFORE the login prompt, so the unattended install never idles at getty.
# NB: intentionally NOT `After=multi-user.target` while `WantedBy=multi-user.target`
# — that is an ordering cycle and systemd SKIPS the unit (same trap documented in
# aios-health-report.service). Order after aios.target + the health report instead.
Wants=aios.target multi-user.target
After=aios.target aios-health-report.service
Before=getty.target serial-getty@ttyS0.service getty@tty1.service

[Service]
# Type=oneshot: this is a run-once install-then-poweroff action, not a daemon.
# It does NOT call `systemctl is-system-running --wait`, so it does not hit the
# oneshot deadlock that aios-health-report.service warns about.
Type=oneshot
ExecStart=/usr/lib/aios/install/aios-autoinstall.sh
# The install marker (AIOS-AUTOINSTALL: SUCCESS / FAILED) and the wrapped
# aios-quick-install.sh output MUST reach the serial console ttyS0 that the gate
# scans. journal+console sends stdout/stderr to /dev/console, which the phase-1
# kernel cmdline maps to ttyS0,115200n8.
StandardOutput=journal+console
StandardError=journal+console
# No time limit: a real disk install can take several minutes; the QEMU gate owns
# the outer timeout. The script always powers the guest off (success or failure),
# so this cannot hang the boot indefinitely.
TimeoutStartSec=0
# Ignore-prefix (leading `-`): if SELinux is not loaded in the live env, do not
# fail the unit trying to transition context. Matches the distro/systemd pattern.
SELinuxContext=-

[Install]
WantedBy=multi-user.target
